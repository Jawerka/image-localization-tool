{
  "manifest_version": 3,
  "name": "Image Localization Tool",
  "version": "1.0.0",
  "description": "Перевод текста на изображениях страницы",
  "permissions": ["storage", "contextMenus", "activeTab", "offscreen"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://ozon.ru/*",
        "*://*.ozon.ru/*",
        "*://ozon.by/*",
        "*://*.ozon.by/*",
        "*://ozon.kz/*",
        "*://*.ozon.kz/*"
      ],
      "js": ["chime.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Localization Tool",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  }
}
